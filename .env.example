# jewelo — environment variables
#
# TWO RUNTIMES. This is the thing that trips people up:
#
#   1. Next.js  -> put in .env.local (this file's format)
#   2. Convex   -> NOT read from .env.local. Convex actions run in Convex's
#                  cloud runtime, so they only see vars you push with:
#                     npx convex env set NAME value
#                  Check what's set with: npx convex env list
#
# Copy to .env.local and fill in. .env*.local is gitignored.


# ─────────────────────────────────────────────────────────────
# NEXT.JS  — .env.local
# ─────────────────────────────────────────────────────────────

# Convex connection. Written automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Optional. Verbosity for src/lib/observability/logger.ts.
# One of: debug | info | warn | error. Defaults to info.
LOG_LEVEL=info


# ─────────────────────────────────────────────────────────────
# CONVEX  — set with `npx convex env set NAME value`
# ─────────────────────────────────────────────────────────────

# Image generation. Gemini 3.1 Flash via @google/genai.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Video generation. Veo 3.1 needs a GCP service account, because the
# Convex runtime cannot auto-discover GCP credentials.
# GOOGLE_SA_JSON is the service account JSON, base64-encoded:
#   base64 -i service-account.json | pbcopy
GCP_PROJECT_ID=
GOOGLE_SA_JSON=

# Live AED gold pricing. https://metalpriceapi.com
METAL_PRICE_API_KEY=

# Stock imagery for reference shots. https://www.pexels.com/api/
PEXELS_API_KEY=

# Gates the /admin panel (convex/lib/adminAuth.ts).
# If unset, non-production falls back to "dev-admin" and production
# refuses all admin access. Set a real value before deploying.
ADMIN_PASSWORD=

# Selects which prompt template set is live.
# One of: development | production. Defaults by NODE_ENV/VERCEL_ENV.
PROMPT_ENVIRONMENT=
NEXT_PUBLIC_PROMPT_ENVIRONMENT=


# ─────────────────────────────────────────────────────────────
# NOT USED
# ─────────────────────────────────────────────────────────────
# REPLICATE_API_TOKEN is present in the old .env.local but no code
# reads it. Replicate/Nano Banana was specced for the kenza-jewelry
# repo, never wired up here. Safe to drop.
