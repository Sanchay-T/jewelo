# Browser-safe
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# Trusted web/job runtimes only
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
TRIGGER_ACCESS_TOKEN=
TRIGGER_PREVIEW_BRANCH=

# Direct OpenAI still generation
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2-2026-04-21
OPENAI_VERIFIER_MODEL=gpt-5.6-luna
OPENAI_IMAGE_CONCURRENCY=4
# Set from the actual project tier; real-provider mode refuses to guess.
OPENAI_IMAGE_REQUESTS_PER_MINUTE=

# fal.ai Seedance inference
FAL_KEY=
FAL_VIDEO_PREVIEW_MODEL=bytedance/seedance-2.0/fast/image-to-video
FAL_VIDEO_FINAL_MODEL=bytedance/seedance-2.0/image-to-video
FAL_VIDEO_PREVIEW_CONCURRENCY=4
FAL_VIDEO_FINAL_CONCURRENCY=1
FAL_REQUIRED_ACCOUNT_CONCURRENCY=4

# Product media profile
VIDEO_PREVIEW_MODE=all_variations
VIDEO_PREVIEW_DURATION_SECONDS=4
VIDEO_FINAL_DURATION_SECONDS=6
VIDEO_RESOLUTION=720p
VIDEO_ASPECT_RATIO=9:16
VIDEO_GENERATE_AUDIO=false

METAL_PRICE_API_KEY=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
POSTHOG_PERSONAL_API_KEY=

# Runtime policy
JEWELO_ENV=development
PROVIDER_MODE=mock
MAX_MODEL_SPEND_PER_RUN_USD=8.50
